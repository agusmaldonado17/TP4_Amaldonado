@page "/carritos/editar/{id:int}"
@using TP4_Amaldonado.Models
@using TP4_Amaldonado.Services
@inject CartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Editar carrito</PageTitle>

<section class="space-y-8">
    <div>
        <button class="mb-5 rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
                @onclick="Volver">
            Volver
        </button>

        <p class="text-sm font-medium uppercase tracking-[0.22em] text-slate-400">
            Modificación de carrito
        </p>

        <h2 class="mt-2 text-4xl font-semibold tracking-tight text-slate-950">
            Editar carrito #@id
        </h2>

        <p class="mt-3 max-w-2xl text-slate-500">
            Modificar y enviar los cambios al endpoint PUT.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="rounded-3xl border border-slate-200 bg-white p-8 text-slate-500 shadow-sm">
            Cargando datos del carrito...
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-3xl border border-red-200 bg-red-50 p-5 text-red-700">
            @errorMessage
        </div>
    }
    else
    {
        <div class="max-w-4xl">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <EditForm Model="cartRequest" OnValidSubmit="GuardarCambios">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="mb-5 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700" />

                    <div class="space-y-6">
                        <div>
                            <label class="mb-2 block text-sm font-semibold text-slate-700">
                                ID de usuario
                            </label>

                            <InputNumber class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:border-slate-400 focus:bg-white"
                                         @bind-Value="cartRequest.UserId" />
                        </div>

                        <div class="rounded-3xl bg-slate-50 p-5">
                            <h3 class="text-lg font-semibold text-slate-950">
                                Producto 1
                            </h3>

                            <div class="mt-4 grid gap-4 md:grid-cols-2">
                                <div>
                                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                                        ID del producto
                                    </label>

                                    <InputNumber class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-slate-400"
                                                 @bind-Value="producto1.Id" />
                                </div>

                                <div>
                                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                                        Cantidad
                                    </label>

                                    <InputNumber class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-slate-400"
                                                 @bind-Value="producto1.Quantity" />
                                </div>
                            </div>
                        </div>

                        <div class="rounded-3xl bg-slate-50 p-5">
                            <h3 class="text-lg font-semibold text-slate-950">
                                Producto 2
                            </h3>

                            <div class="mt-4 grid gap-4 md:grid-cols-2">
                                <div>
                                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                                        ID del producto
                                    </label>

                                    <InputNumber class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-slate-400"
                                                 @bind-Value="producto2.Id" />
                                </div>

                                <div>
                                    <label class="mb-2 block text-sm font-semibold text-slate-700">
                                        Cantidad
                                    </label>

                                    <InputNumber class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-slate-400"
                                                 @bind-Value="producto2.Quantity" />
                                </div>
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full rounded-2xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60 md:w-auto"
                                disabled="@isSaving">
                            @(isSaving ? "Guardando..." : "Guardar cambios")
                        </button>
                    </div>
                </EditForm>
            </div>

        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-700">
                @successMessage
            </div>
        }

        @if (updatedCart is not null)
        {
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-[0.22em] text-slate-400">
                            Resultado
                        </p>

                        <h3 class="mt-2 text-2xl font-semibold text-slate-950">
                            Carrito actualizado
                        </h3>
                    </div>

                    <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700">
                        ID @updatedCart.Id
                    </span>
                </div>

                <div class="mt-6 grid gap-4 md:grid-cols-4">
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <p class="text-sm text-slate-500">Usuario</p>
                        <p class="mt-1 text-xl font-semibold text-slate-950">@updatedCart.UserId</p>
                    </div>

                    <div class="rounded-2xl bg-slate-50 p-4">
                        <p class="text-sm text-slate-500">Productos</p>
                        <p class="mt-1 text-xl font-semibold text-slate-950">@updatedCart.TotalProducts</p>
                    </div>

                    <div class="rounded-2xl bg-slate-50 p-4">
                        <p class="text-sm text-slate-500">Cantidad total</p>
                        <p class="mt-1 text-xl font-semibold text-slate-950">@updatedCart.TotalQuantity</p>
                    </div>

                    <div class="rounded-2xl bg-emerald-50 p-4">
                        <p class="text-sm text-emerald-700">Total con descuento</p>
                        <p class="mt-1 text-xl font-semibold text-emerald-800">$@updatedCart.DiscountedTotal</p>
                    </div>
                </div>
            </div>
        }
    }
</section>

@code {
    [Parameter]
    public int id { get; set; }

    private CartRequest cartRequest = new();
    private CartRequestProduct producto1 = new();
    private CartRequestProduct producto2 = new();

    private Cart? updatedCart;
    private bool isLoading = true;
    private bool isSaving;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarCarrito();
    }

    private async Task CargarCarrito()
    {
        isLoading = true;
        errorMessage = null;

        var cart = await CartService.GetCartByIdAsync(id);

        if (cart is null)
        {
            errorMessage = "No se pudo cargar el carrito para editar.";
            isLoading = false;
            return;
        }

        cartRequest.UserId = cart.UserId;

        if (cart.Products.Count > 0)
        {
            producto1.Id = cart.Products[0].Id;
            producto1.Quantity = cart.Products[0].Quantity;
        }

        if (cart.Products.Count > 1)
        {
            producto2.Id = cart.Products[1].Id;
            producto2.Quantity = cart.Products[1].Quantity;
        }

        isLoading = false;
    }

    private async Task GuardarCambios()
    {
        isSaving = true;
        successMessage = null;
        errorMessage = null;
        updatedCart = null;

        cartRequest.Products = new List<CartRequestProduct>
        {
            producto1,
            producto2
        }
        .Where(p => p.Id > 0 && p.Quantity > 0)
        .ToList();

        if (cartRequest.UserId <= 0 || cartRequest.Products.Count == 0)
        {
            errorMessage = "Debe ingresar un usuario válido y al menos un producto.";
            isSaving = false;
            return;
        }

        updatedCart = await CartService.UpdateCartAsync(id, cartRequest);

        if (updatedCart is not null)
        {
            successMessage = "El carrito fue actualizado correctamente. DummyJSON simula la modificación, pero no guarda el cambio de forma permanente.";
        }
        else
        {
            errorMessage = "No se pudo actualizar el carrito.";
        }

        isSaving = false;
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/carritos");
    }
}