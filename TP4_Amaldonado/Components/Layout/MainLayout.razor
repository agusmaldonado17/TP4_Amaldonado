@inherits LayoutComponentBase

<div class="min-h-screen bg-[#f7f7f4] text-slate-900">
    <div class="flex min-h-screen">

        <aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white lg:block">
            <NavMenu />
        </aside>

        <div class="flex min-w-0 flex-1 flex-col">
            <header class="border-b border-slate-200 bg-white">
                <div class="flex h-16 items-center justify-between px-8">


                    <div class="flex items-center gap-3">


                        <span class="rounded-full bg-emerald-50 px-4 py-2 text-sm font-medium text-emerald-700">
                            Conectado
                        </span>
                    </div>
                </div>
            </header>

            <main class="flex-1 px-8 py-8">
                @Body
            </main>
        </div>
    </div>
</div>